# Copie para .env e preencha
APISPORTS_KEY=sua_chave_aqui
# Opcional: bookmaker padrão (8 = Bet365)
BOOKMAKER_ID=8
# Opcional: pausa entre chamadas à API (segundos)
REQUEST_PAUSE=0.25
# Painel web: usuário e senha de acesso pelo navegador
PANEL_USER=admin
PANEL_PASSWORD=crie_uma_senha_forte
# Alerta diário no Telegram (opcional): crie um bot com o @BotFather,
# cole o token aqui, mande /start pro bot e pegue seu id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL pública do painel (usada nos links do bilhete no Telegram)
PANEL_URL=http://SEU_IP:8000
