# Copie para .env e preencha
APISPORTS_KEY=sua_chave_aqui
# Opcional: bookmaker padrão (8 = Bet365)
BOOKMAKER_ID=8
# Opcional: pausa entre chamadas à API (segundos)
REQUEST_PAUSE=0.25
# Conta admin inicial: na PRIMEIRA execução, se ainda não há usuários,
# o ChapaFut cria essa conta a partir daqui (depois o cadastro é pelo site).
PANEL_USER=admin
PANEL_PASSWORD=crie_uma_senha_forte
# Bot do Telegram (compartilhado por todos os usuários): crie com o
# @BotFather e cole o token. Cada usuário cadastra o próprio chat_id no
# painel (aba Tracker). TELEGRAM_CHAT_ID abaixo é opcional (fallback).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL pública do painel (usada nos links do bilhete no Telegram)
PANEL_URL=http://SEU_IP:8000
# --- Acesso pago (liberação manual) ---
# Chave PIX mostrada na tela de conta pendente (NÃO vai pro git, fica só aqui)
PIX_KEY=
# Como o usuário te manda o comprovante (ex.: @seu_telegram)
PIX_CONTATO=
# Teto de contas pagantes ativas ao mesmo tempo
MAX_ACTIVE_USERS=100
# Quem é o admin (vê /admin). Padrão: o PANEL_USER acima.
ADMIN_USER=admin
